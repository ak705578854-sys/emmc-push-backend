# Server port (Render supplies PORT automatically)
PORT=3001

# Comma-separated frontend origins. Use your Vercel URL in production.
FRONTEND_ORIGIN=https://YOUR-VERCEL-APP.vercel.app

# Generate with: npm run generate-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
